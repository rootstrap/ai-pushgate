#!/usr/bin/env bash
# Pushgate pre-push hook delegator.
#
# Git invokes this file. The installer owns the Pushgate runner and keeps this
# hook small so policy changes can land behind a stable hook boundary.

set -u

HOOK_VERSION="2.2.0" # x-release-please-version
HOOK_PROTOCOL="1"
PUSHGATE_HOME="${HOME:-}/.pushgate"
PUSHGATE_RUNNER="${PUSHGATE_HOME}/bin/pushgate"

repo_root() {
  git rev-parse --show-toplevel 2>/dev/null || pwd
}

error() {
  printf '[pushgate] %s\n' "$*" >&2
}

reinstall_hint() {
  error "Reinstall Pushgate from ${REPO_ROOT}:"
  error "  curl -fsSL https://raw.githubusercontent.com/rootstrap/ai-pushgate/main/install.sh | bash"
}

REPO_ROOT="$(repo_root)"

if [ -z "${HOME:-}" ]; then
  error "HOME is not set, so the installed Pushgate runner cannot be resolved for ${REPO_ROOT}."
  reinstall_hint
  exit 1
fi

if [ ! -e "$PUSHGATE_RUNNER" ]; then
  error "Pushgate runner not found at ${PUSHGATE_RUNNER} for ${REPO_ROOT}."
  reinstall_hint
  exit 1
fi

if [ ! -x "$PUSHGATE_RUNNER" ]; then
  error "Pushgate runner at ${PUSHGATE_RUNNER} is not executable for ${REPO_ROOT}."
  reinstall_hint
  exit 1
fi

if ! RUNNER_PROTOCOL="$("$PUSHGATE_RUNNER" hook-protocol 2>/dev/null)"; then
  error "Pushgate runner at ${PUSHGATE_RUNNER} could not report its hook protocol."
  reinstall_hint
  exit 1
fi

if [ "$RUNNER_PROTOCOL" != "$HOOK_PROTOCOL" ]; then
  error "Pushgate runner at ${PUSHGATE_RUNNER} uses hook protocol ${RUNNER_PROTOCOL:-unknown}; this hook requires ${HOOK_PROTOCOL}."
  reinstall_hint
  exit 1
fi

exec "$PUSHGATE_RUNNER" pre-push "$@"
