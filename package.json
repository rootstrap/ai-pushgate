{
  "name": "ai-pushgate",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm run bundle",
    "bundle": "node scripts/build-runner.mjs",
    "check:shell": "bash -n hook/pre-push && bash -n install.sh",
    "lint:shell": "shellcheck --severity=error hook/pre-push install.sh",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run typecheck && pnpm run bundle && tsx --test test/*.test.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ignore": "^7.0.5",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.9",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "exports": {
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./path-policy": {
      "types": "./dist/path-policy/index.d.ts",
      "default": "./dist/path-policy/index.js"
    }
  }
}
